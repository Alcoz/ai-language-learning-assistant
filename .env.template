# Langfuse (Settings > API Keys in the Langfuse UI)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Ollama model of the teacher, pulled beforehand with `ollama pull <model>`
OLLAMA_MODEL=qwen3.5:4b

# faster-whisper model: tiny, base, small, medium, large-v3, large-v3-turbo...
WHISPER_MODEL_SIZE=small

# Keep the student's recordings and their transcription for the STT benchmark
ARCHIVE_RECORDINGS=false

# Any S3-compatible storage, selected by its endpoint:
#   MinIO   http://localhost:9000
#   AWS S3  https://s3.<region>.amazonaws.com
#   GCS     https://storage.googleapis.com (HMAC keys, Settings > Interoperability)
S3_API=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
# Any value for MinIO, the bucket region for AWS, "auto" for GCS
REGION_NAME=us-east-1
# Must already exist
BUCKET_NAME=stt-recordings

# Label Studio, read by `make export-labels`
LABEL_STUDIO_URL=http://localhost:8080
# Account & Settings > Personal Access Token
LABEL_STUDIO_API_KEY=
LABEL_STUDIO_PROJECT_ID=1

# Read by `make evaluate-stt`
MLFLOW_TRACKING_URI=http://localhost:5000
